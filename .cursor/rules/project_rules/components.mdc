# 📋 Паттерны React компонентов для лендингов

## 🏗️ Структура компонента Widget (секция лендинга)

### 📋 Стандартный паттерн секции
```typescript
"use client";

import { motion } from 'framer-motion';
import { useTranslations } from 'next-intl';
import { Section } from '@/src/shared/ui/Section';
import { Container } from '@/src/shared/ui/Container';
import { Heading, Text } from '@/src/shared/ui/Typography';
import cls from './SectionName.module.scss';

/**
 * SectionName - описание назначения секции
 */
export function SectionName() {
  const t = useTranslations('sectionName');

  return (
    <Section id="section-name" background="dark" padding="lg">
      <Container maxWidth="xl">
        <motion.div
          initial={{ opacity: 0, y: 30 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.6 }}
          className={cls.content}
        >
          <Heading level={2} align="center">
            {t('title')}
          </Heading>
          <Text align="center" size="lg">
            {t('description')}
          </Text>
        </motion.div>
      </Container>
    </Section>
  );
}
```

### 🎯 Ключевые принципы widgets
- **"use client"** директива для интерактивности
- **Framer Motion** для анимаций появления
- **Section wrapper** для консистентного оформления
- **Container** для ограничения ширины контента
- **ID секции** для якорных ссылок из навигации

