<Heading level={1}>{t('title')}</Heading>

// ✅ ХОРОШО - CSS модули
<div className={cls.container}>

// ✅ ХОРОШО - строгие типы
const data: FeatureData = props.data;

// ✅ ХОРОШО - оптимизированные анимации
