## 📦 Code Splitting

### 🔄 Динамические импорты для тяжелых компонентов
```typescript
import dynamic from 'next/dynamic';

// Ленивая загрузка секции с видео/картами
const VideoSection = dynamic(() => import('@/src/widgets/VideoSection'), {
  loading: () => <div>Загрузка...</div>,
  ssr: false  // Отключить SSR если не нужен
});

// Ленивая загрузка библиотек
const Chart = dynamic(() => import('react-chartjs-2'), {
  ssr: false
});

export function MainPage() {
  return (
    <>
      <Hero />           {/* Загружается сразу */}
      <Features />       {/* Загружается сразу */}
      <VideoSection />   {/* Lazy loaded */}
    </>
  );
}
```

