## 🔗 Типизация ссылок

### 🌐 Link компоненты
```typescript
interface LinkProps {
  href: string;
  children: ReactNode;
  external?: boolean;
  className?: string;
}

export const Link: FC<LinkProps> = (props) => {
  const { href, children, external, className } = props;
  
  if (external) {
    return (
      <a 
        href={href} 
        target="_blank" 
        rel="noopener noreferrer"
        className={className}
      >
        {children}
      </a>
    );
  }
  
  return (
    <NextLink href={href} className={className}>
      {children}
    </NextLink>
  );
};
```

