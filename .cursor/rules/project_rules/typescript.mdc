## ❌ Антипаттерны

### 🚫 Что НЕ делать
```typescript
// ❌ ПЛОХО - any типы
const data: any = response;
const handleClick = (e: any) => {};

// ❌ ПЛОХО - неявная типизация
const features = [
  { title: 'Feature 1' },
  { title: 'Feature 2' }
];

// ❌ ПЛОХО - игнорирование ошибок
// @ts-ignore
const value = unknownObject.property;
```

### ✅ Правильные альтернативы
```typescript
// ✅ ХОРОШО - строгие типы
const data: ApiResponse = response;
const handleClick = (e: React.MouseEvent<HTMLButtonElement>) => {};

// ✅ ХОРОШО - явная типизация
interface Feature {
  title: string;
}

const features: Feature[] = [
  { title: 'Feature 1' },
  { title: 'Feature 2' }
];

// ✅ ХОРОШО - type guard или optional chaining
const value = unknownObject?.property;
if ('property' in unknownObject) {
  const value = unknownObject.property;
}
```

